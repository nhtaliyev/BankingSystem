@using BankingSystem.MVC.Enums
@model BankingSystem.MVC.ViewModels.Accounts.CreateAccountViewModel
@{
    ViewData["Title"] = "Open new account";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-4">Open new account</h1>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Currency" class="form-label"></label>
                <select asp-for="Currency" asp-items="Html.GetEnumSelectList<Currency>()" class="form-select">
                    <option value="">Select currency</option>
                </select>
                <span asp-validation-for="Currency" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Open account</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
