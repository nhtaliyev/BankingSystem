@model BankingSystem.MVC.ViewModels.Cards.CreateCardViewModel
@{
    ViewData["Title"] = "Issue new card";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-4">Issue new card</h1>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="AccountId" />

            <div class="mb-3">
                <label asp-for="DailyLimit" class="form-label"></label>
                <input asp-for="DailyLimit" type="number" step="0.01" min="0.01" max="10000" class="form-control" />
                <div class="form-text">Maximum 10,000.00 per day.</div>
                <span asp-validation-for="DailyLimit" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Issue card</button>
            <a asp-controller="Accounts" asp-action="Details" asp-route-id="@Model.AccountId" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}