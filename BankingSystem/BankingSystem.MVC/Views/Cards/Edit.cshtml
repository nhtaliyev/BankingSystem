@model BankingSystem.MVC.ViewModels.Cards.EditCardViewModel
@{
    ViewData["Title"] = "Change daily limit";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-4">Change daily limit</h1>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RowVersion" />

            <div class="mb-3">
                <label asp-for="DailyLimit" class="form-label"></label>
                <input asp-for="DailyLimit" type="number" step="0.01" min="0.01" max="10000" class="form-control" />
                <div class="form-text">Maximum 10,000.00 per day.</div>
                <span asp-validation-for="DailyLimit" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            @* If the card was changed elsewhere, the old RowVersion is stale: reloading this page fetches the new one. *@
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-link">Reload</a>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}